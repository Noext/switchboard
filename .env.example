# Public URL used for OAuth callbacks and install snippets
SWITCHBOARD_PUBLIC_URL=https://switchboard.example.com
# Admin UI password (change me)
SWITCHBOARD_ADMIN_PASSWORD=changeme
# Cookie signing secret (>= 32 chars)
SWITCHBOARD_SECRET=change-me-to-a-long-random-string-32
# Master encryption key: base64 of 32 random bytes. Optional; generated into data/master.key at first run.
# SWITCHBOARD_MASTER_KEY=
SWITCHBOARD_DATA_DIR=./data
SWITCHBOARD_PORT=3020
SWITCHBOARD_LOG_LEVEL=info
